@using VoltigeCore.Business.Logic.Import
@model VoltigeCore.ViewModels.ImportViewModel

@{
    ViewData["Title"] = "Importera från TDB";
}

<h2>Importera från TDB</h2>

<form method="post" enctype="multipart/form-data" asp-controller="Import" asp-action="Upload">
    <div class="mb-3">
        <input type="file" name="file" class="form-control" />
    </div>
    <div class="mb-2">
        <input type="checkbox" name="addNewCheckbox" id="AddNewCheckbox" value="on" />
        <label for="AddNewCheckbox">Lägg till nya</label>
    </div>
    <div class="mb-2">
        <input type="checkbox" name="updateCheckbox" id="UpdateCheckbox" value="on" />
        <label for="UpdateCheckbox">Uppdatera redan existerande</label>
    </div>
    <div class="mb-2">
        <input type="checkbox" name="excludeStartlist" id="excludeStartlist" value="on" checked />
        <label for="excludeStartlist">Gör ingen koll av startlistan</label>
    </div>
    <div class="mb-2">
        <input type="checkbox" name="excludeTeam" id="excludeTeam" value="on" checked />
        <label for="excludeTeam">Uppdatera eller lägg inte till lag</label>
    </div>
    <button type="submit" class="btn btn-primary">Upload</button>
</form>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Tillbaka</a>
</div>

@if (Model != null)
{
    <div class="mt-4">
        <div>Nya longörer: @Model.NewLungers <br />Uppdaterade longörer: @Model.UppdatedLungers</div>
        <div>Nya hästar: @Model.NewHorses <br />Updaterade hästar: @Model.UpdatedHorses</div>
        <div>Nya klubbar: @Model.NewClubs <br />Updaterade klubbar: @Model.UpdatedClubs</div>
        <div>Nya klasser: @Model.NewClasses <br />Updaterade klasser: @Model.UpdatedClasses</div>
        <div>Nya voltigörer: @Model.NewVaulters <br />Updaterade voltigörer: @Model.UpdatedVaulters</div>
        <div>Nya lag: @Model.NewTeams <br />Updaterade lag: @Model.UpdatedTeams</div>
        <div>Nya lagmedlemmar: @Model.NewTeamMembers <br />Updaterade lagmedlemmar: @Model.UpdatedTeamMembers</div>

        @foreach (var item in Model.ChangedStartListTeamList ?? new Dictionary<int, Changed>())
        {
            <div>
                <label>Startlisteklass:</label> @item.Key <br />
                <label>Ny startlista för lag:</label> @item.Value.New <br />
                <label>Ändrad startlista för lag:</label> @item.Value.Updated
            </div>
        }

        @foreach (var item in Model.ChangedStartListIndividualList ?? new Dictionary<int, VoltigeCore.Business.Logic.Import.UpdateService.NewHordeorders>())
        {
            <div>
                <label>Startlisteklass:</label> @item.Key <br />
                <label>Ny startlista för häst:</label> @item.Value.NewHorseOrders <br />
                <label>Nya Individuell på häst:</label> @item.Value.NewVaulterOrders
            </div>
        }
    </div>
}
