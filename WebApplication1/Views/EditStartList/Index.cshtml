@using VoltigeCore.Classes
@using VoltigeCore.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@model VoltigeCore.Models.Contest

@{
    ViewData["Title"] = "Redigera startlista";
    var horseOptions = ViewBag.HorseOptions as List<SelectListItem> ?? new List<SelectListItem>();

    var horseOrderInfoList = Model.GetActiveStartListClassStep()
        .SelectMany(step => step.GetActiveStartList()
            .Where(ho => !ho.IsTeam)
            .Select(ho => new {
                HorseOrderId = ho.HorseOrderId,
                StepId = ho.StartListClassStepId,
                StartNumber = ho.StartNumber,
                Display = (ho.HorseInformation?.HorseName ?? "?") +
                    (ho.HorseInformation?.Lunger?.LungerName != null
                        ? " (" + ho.HorseInformation.Lunger.LungerName + ")" : ""),
                Vaulters = ho.GetActiveVaulters()
                    .OrderBy(v => v.StartOrder)
                    .Select(v => new {
                        Id = v.VaulterOrderID,
                        Name = v.Participant?.Name ?? "",
                        Order = v.StartOrder
                    }).ToList()
            }))
        .ToList();
    var horseOrderJson = System.Text.Json.JsonSerializer.Serialize(horseOrderInfoList);

    var stepsData = Model.GetActiveStartListClassStep()
        .OrderBy(s => s.StartOrder)
        .Select(s => new { StepId = s.StartListClassStepId, Name = s.Name })
        .ToList();
    var stepsJson = System.Text.Json.JsonSerializer.Serialize(stepsData);
}

<div class="d-flex align-items-center mb-3">
    <h2 class="mb-0 me-3">Redigera startlista</h2>
    <a asp-controller="Help" asp-action="Index" class="btn btn-outline-secondary btn-sm">Hjälp / Help</a>
</div>

<table class="table table-bordered table-sm">
    @{int startnumber = 0;}
    @foreach (var startListClassStep in Model.GetActiveStartListClassStep().OrderBy(x => x.StartOrder))
    {
        startnumber = 0;
        <tr>
            <th>@startListClassStep.Date.ToLocalTime()</th>
            <th colspan="4">@startListClassStep.Name</th>
            <th></th>
        </tr>
        <tr>
            <td></td>
            <td colspan="4">
                @if (!string.IsNullOrWhiteSpace(startListClassStep.GetJudgeName(JudgeTableNames.A)))
                {
                    <div>
                        Domare A: @startListClassStep.GetJudgeName(JudgeTableNames.A)
                        B: @startListClassStep.GetJudgeName(JudgeTableNames.B)
                        C: @startListClassStep.GetJudgeName(JudgeTableNames.C)
                        D: @startListClassStep.GetJudgeName(JudgeTableNames.D)
                    </div>
                }
            </td>
            <td></td>
        </tr>
        @foreach (var startListItem in startListClassStep.GetActiveStartList().OrderBy(x => x.StartNumber))
        {
            if (startListItem.IsTeam)
            {
                startnumber++;
                <tr>
                    <td>@startnumber</td>
                    <td>@startListItem.VaultingTeam?.Name</td>
                    <td>
                        @startListItem.HorseInformation?.HorseName
                        <button type="button" class="btn btn-sm btn-outline-primary ms-1 btn-change-horse"
                                data-bs-toggle="modal" data-bs-target="#editHorseModal"
                                data-horse-order-id="@startListItem.HorseOrderId"
                                data-current-horse-id="@startListItem.HorseId"
                                data-participant="@startListItem.VaultingTeam?.Name"
                                data-is-team="true">
                            Byt häst
                        </button>
                    </td>
                    <td>@startListItem.HorseInformation?.Lunger?.LungerName</td>
                    <td>@startListItem.VaultingTeam?.VaultingClass?.ClassName klass: @startListItem.VaultingTeam?.VaultingClass?.ClassNr -
                        @(ExcelPreCompetitionData.GetCompetitionStep(Model.TypeOfContest, startListItem.VaultingTeam?.VaultingClass, startListItem.TeamTestnumber)?.Name)
                    </td>
                    <td>
                        @startListItem.VaultingTeam?.VaultingClub?.ClubName
                        (@startListItem.VaultingTeam?.VaultingClub?.Country)
                        <br />Voltigörer:<br />
                        @if (startListItem.VaultingTeam?.TeamList != null)
                        {
                            foreach (var vaulter in startListItem.VaultingTeam.TeamList.OrderBy(x => x.StartNumber))
                            {
                                @vaulter.Participant?.Name
                                <br />
                            }
                        }
                    </td>
                </tr>
            }
            else
            {
                foreach (var vaulters in startListItem.GetActiveVaulters().OrderBy(x => x.StartOrder))
                {
                    startnumber++;
                    <tr>
                        <td>@startnumber</td>
                        <td>@vaulters.Participant?.Name (@vaulters.Participant?.Armband)</td>
                        <td>
                            @startListItem.HorseInformation?.HorseName
                            <button type="button" class="btn btn-sm btn-outline-primary ms-1 btn-change-horse"
                                    data-bs-toggle="modal" data-bs-target="#editHorseModal"
                                    data-horse-order-id="@startListItem.HorseOrderId"
                                    data-current-horse-id="@startListItem.HorseId"
                                    data-participant="@vaulters.Participant?.Name"
                                    data-vaulter-order-id="@vaulters.VaulterOrderID"
                                    data-step-id="@startListItem.StartListClassStepId"
                                    data-is-team="false">
                                Byt häst
                            </button>
                        </td>
                        <td>@startListItem.HorseInformation?.Lunger?.LungerName</td>
                        <td>@vaulters.Participant?.VaultingClass?.ClassName -
                            @(ExcelPreCompetitionData.GetCompetitionStep(Model.TypeOfContest, vaulters.Participant?.VaultingClass, vaulters.Testnumber)?.Name)
                        </td>
                        <td>@vaulters.Participant?.VaultingClub?.ClubName (@vaulters.Participant?.VaultingClub?.Country)</td>
                    </tr>
                }
            }
        }
    }
</table>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Tillbaka</a>
</div>

<!-- Modal: Byt häst -->
<div class="modal fade" id="editHorseModal" tabindex="-1" aria-labelledby="editHorseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editHorseModalLabel">Byt häst</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p id="modalParticipantLabel" class="fw-bold mb-3"></p>

                <!-- Mode selector (hidden for teams) -->
                <div id="modeSelector" class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="changeMode" id="modeAll" value="all" checked>
                        <label class="form-check-label" for="modeAll">Byt häst för alla på denna startplats</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="changeMode" id="modeSingle" value="single">
                        <label class="form-check-label" for="modeSingle">Flytta voltigör till en annan befintlig startplats</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="changeMode" id="modeSplit" value="split">
                        <label class="form-check-label" for="modeSplit">Ge voltigören en ny häst, behåll startplatsen</label>
                    </div>
                </div>

                <!-- Mode 1: change horse for the whole HorseOrder -->
                <div id="mode1Section">
                    <form id="form1" asp-controller="EditStartList" asp-action="UpdateHorse" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="modalHorseOrderId" name="horseOrderId" />
                        <div class="mb-3">
                            <label for="modalHorseSelect" class="form-label">Häst</label>
                            <select id="modalHorseSelect" name="horseId" class="form-select">
                                @foreach (var opt in horseOptions)
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            </select>
                        </div>
                    </form>
                </div>

                <!-- Mode 2: move this vaulter to a different existing HorseOrder -->
                <div id="mode2Section" style="display:none">
                    <form id="form2" asp-controller="EditStartList" asp-action="MoveVaulter" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="movingVaulterOrderId" name="vaulterOrderId" />
                        <input type="hidden" id="movingVaulterNameHidden" />
                        <div class="mb-3">
                            <label for="targetStepSelect" class="form-label">Omgång</label>
                            <select id="targetStepSelect" class="form-select">
                                <option value="">-- Välj omgång --</option>
                            </select>
                        </div>
                        <div class="mb-3" id="targetHorseOrderDiv" style="display:none">
                            <label for="targetHorseOrderSelect" class="form-label">Häst (startplats)</label>
                            <select id="targetHorseOrderSelect" name="targetHorseOrderId" class="form-select">
                                <option value="">-- Välj häst --</option>
                            </select>
                        </div>
                        <div id="vaulterOrderInputs"></div>
                    </form>
                </div>

                <!-- Mode 3: give vaulter a new HorseOrder with chosen horse, keep position, split if needed -->
                <div id="mode3Section" style="display:none">
                    <form id="form3" asp-controller="EditStartList" asp-action="SplitAndMoveVaulter" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="mode3VaulterOrderId" name="vaulterOrderId" />
                        <div class="mb-3">
                            <label for="mode3HorseSelect" class="form-label">Ny häst</label>
                            <select id="mode3HorseSelect" name="newHorseId" class="form-select">
                                @foreach (var opt in horseOptions)
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            </select>
                        </div>
                        <p class="text-muted small mb-0">Voltigören behåller sin plats i startlistan och får en egen startplats med den valda hästen. Om det finns voltigörer efter hen på ursprungshästen skapas automatiskt en ny startplats för dem.</p>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="submit" form="form1" id="submitMode1" class="btn btn-primary">Spara</button>
                <button type="submit" form="form2" id="submitMode2" class="btn btn-primary" style="display:none">Spara</button>
                <button type="submit" form="form3" id="submitMode3" class="btn btn-primary" style="display:none">Spara</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const allHorseOrders = @Html.Raw(horseOrderJson);
    const allSteps = @Html.Raw(stepsJson);
    let currentSourceHorseOrderId = null;

    const modal = document.getElementById('editHorseModal');
    modal.addEventListener('show.bs.modal', function (event) {
        const btn = event.relatedTarget;
        const horseOrderId = parseInt(btn.dataset.horseOrderId);
        const currentHorseId = btn.dataset.currentHorseId;
        const participant = btn.dataset.participant;
        const isTeam = btn.dataset.isTeam === 'true';
        const vaulterOrderId = btn.dataset.vaulterOrderId ? parseInt(btn.dataset.vaulterOrderId) : null;
        const stepId = btn.dataset.stepId ? parseInt(btn.dataset.stepId) : null;

        currentSourceHorseOrderId = horseOrderId;
        document.getElementById('modalParticipantLabel').textContent = participant;
        document.getElementById('modalHorseOrderId').value = horseOrderId;
        document.getElementById('modalHorseSelect').value = currentHorseId;

        const modeSelector = document.getElementById('modeSelector');
        if (isTeam) {
            modeSelector.style.display = 'none';
            showMode(1);
        } else {
            modeSelector.style.display = '';
            document.getElementById('modeAll').checked = true;
            document.getElementById('movingVaulterOrderId').value = vaulterOrderId;
            document.getElementById('movingVaulterNameHidden').value = participant;
            document.getElementById('mode3VaulterOrderId').value = vaulterOrderId;
            document.getElementById('mode3HorseSelect').value = currentHorseId;

            // Populate step dropdown and pre-select the vaulter's current step
            initStepDropdown(stepId);
            showMode(1);
        }
    });

    document.getElementById('modeAll').addEventListener('change', () => showMode(1));
    document.getElementById('modeSingle').addEventListener('change', () => showMode(2));
    document.getElementById('modeSplit').addEventListener('change', () => showMode(3));

    document.getElementById('targetStepSelect').addEventListener('change', function () {
        const stepId = parseInt(this.value);
        document.getElementById('vaulterOrderInputs').innerHTML = '';
        if (!stepId) {
            document.getElementById('targetHorseOrderDiv').style.display = 'none';
            document.getElementById('targetHorseOrderSelect').innerHTML = '<option value="">-- Välj häst --</option>';
            return;
        }
        populateHorseDropdown(stepId);
        document.getElementById('targetHorseOrderDiv').style.display = '';
    });

    document.getElementById('targetHorseOrderSelect').addEventListener('change', function () {
        const targetId = parseInt(this.value);
        if (!targetId) {
            document.getElementById('vaulterOrderInputs').innerHTML = '';
            return;
        }
        const movingVaulterOrderId = parseInt(document.getElementById('movingVaulterOrderId').value);
        const movingVaulterName = document.getElementById('movingVaulterNameHidden').value;
        renderVaulterOrderInputs(targetId, currentSourceHorseOrderId, movingVaulterOrderId, movingVaulterName);
    });

    function showMode(mode) {
        document.getElementById('mode1Section').style.display = mode === 1 ? '' : 'none';
        document.getElementById('mode2Section').style.display = mode === 2 ? '' : 'none';
        document.getElementById('mode3Section').style.display = mode === 3 ? '' : 'none';
        document.getElementById('submitMode1').style.display = mode === 1 ? '' : 'none';
        document.getElementById('submitMode2').style.display = mode === 2 ? '' : 'none';
        document.getElementById('submitMode3').style.display = mode === 3 ? '' : 'none';
    }

    function initStepDropdown(currentStepId) {
        const stepSelect = document.getElementById('targetStepSelect');
        stepSelect.innerHTML = '<option value="">-- Välj omgång --</option>';
        allSteps.forEach(s => {
            const opt = document.createElement('option');
            opt.value = s.StepId;
            opt.textContent = s.Name;
            if (s.StepId === currentStepId) opt.selected = true;
            stepSelect.appendChild(opt);
        });

        // Pre-populate horse dropdown for the current step
        if (currentStepId) {
            populateHorseDropdown(currentStepId);
            document.getElementById('targetHorseOrderDiv').style.display = '';
        } else {
            document.getElementById('targetHorseOrderDiv').style.display = 'none';
            document.getElementById('targetHorseOrderSelect').innerHTML = '<option value="">-- Välj häst --</option>';
        }
        document.getElementById('vaulterOrderInputs').innerHTML = '';
    }

    function populateHorseDropdown(stepId) {
        const select = document.getElementById('targetHorseOrderSelect');
        select.innerHTML = '<option value="">-- Välj häst --</option>';

        allHorseOrders
            .filter(ho => ho.StepId === stepId && ho.HorseOrderId !== currentSourceHorseOrderId)
            .sort((a, b) => a.StartNumber - b.StartNumber)
            .forEach(ho => {
                const opt = document.createElement('option');
                opt.value = ho.HorseOrderId;
                const vaulterPart = ho.Vaulters.length > 0
                    ? ' – ' + ho.Vaulters.map(v => `${v.Order}. ${v.Name}`).join(', ')
                    : '';
                opt.textContent = ho.Display + vaulterPart;
                select.appendChild(opt);
            });

        document.getElementById('vaulterOrderInputs').innerHTML = '';
    }

    function renderVaulterOrderInputs(targetHorseOrderId, sourceHorseOrderId, movingVaulterOrderId, movingVaulterName) {
        const targetHo = allHorseOrders.find(h => h.HorseOrderId === targetHorseOrderId);
        const sourceHo = allHorseOrders.find(h => h.HorseOrderId === sourceHorseOrderId);
        if (!targetHo) return;

        // Remaining vaulters on source after the move, renumbered from 1
        const sourceRemaining = (sourceHo ? sourceHo.Vaulters.filter(v => v.Id !== movingVaulterOrderId) : [])
            .slice().sort((a, b) => a.Order - b.Order);

        // Vaulters on target plus the moved vaulter
        const targetVaulters = targetHo.Vaulters.map(v => ({ Id: v.Id, Name: v.Name, Order: v.Order }));
        targetVaulters.push({ Id: movingVaulterOrderId, Name: movingVaulterName, Order: targetVaulters.length + 1 });
        targetVaulters.sort((a, b) => a.Order - b.Order);

        let html = '';

        if (sourceRemaining.length > 0) {
            const sourceLabel = sourceHo ? sourceHo.Display : 'ursprunglig häst';
            html += `<p class="mt-3 mb-1 fw-semibold">Ny startordning på ${sourceLabel}:</p>`;
            html += '<table class="table table-sm"><thead><tr><th>Voltigör</th><th>Startordning</th></tr></thead><tbody>';
            sourceRemaining.forEach((v, idx) => {
                html += `<tr>
                    <td>${v.Name}<input type="hidden" name="sourceVaulterOrderIds" value="${v.Id}"></td>
                    <td><input type="number" name="sourceStartOrders" class="form-control form-control-sm" min="1" value="${idx + 1}" style="width:70px"></td>
                </tr>`;
            });
            html += '</tbody></table>';
        }

        html += `<p class="mt-3 mb-1 fw-semibold">Startordning på ${targetHo.Display}:</p>`;
        html += '<table class="table table-sm"><thead><tr><th>Voltigör</th><th>Startordning</th></tr></thead><tbody>';
        targetVaulters.forEach((v, idx) => {
            html += `<tr>
                <td>${v.Name}<input type="hidden" name="targetVaulterOrderIds" value="${v.Id}"></td>
                <td><input type="number" name="targetStartOrders" class="form-control form-control-sm" min="1" value="${idx + 1}" style="width:70px"></td>
            </tr>`;
        });
        html += '</tbody></table>';

        document.getElementById('vaulterOrderInputs').innerHTML = html;
    }
</script>
}
