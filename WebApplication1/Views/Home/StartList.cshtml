@using VoltigeCore.Classes
@using VoltigeCore.Models
@model VoltigeCore.Models.Contest

@{
    ViewData["Title"] = "Startlista";
}

<h2>Startlista</h2>

<table class="table table-bordered table-sm">
    @{int startnumber = 0;}
    @foreach (var startListClassStep in Model.GetActiveStartListClassStep().OrderBy(x => x.StartOrder))
    {
        startnumber = 0;
        <tr>
            <th>@startListClassStep.Date.ToLocalTime()</th>
            <th colspan="4">@startListClassStep.Name</th>
            <th></th>
        </tr>
        <tr>
            <td></td>
            <td colspan="4">
                @if (!string.IsNullOrWhiteSpace(startListClassStep.GetJudgeName(JudgeTableNames.A)))
                {
                    <div>
                        Domare A: @startListClassStep.GetJudgeName(JudgeTableNames.A)
                        B: @startListClassStep.GetJudgeName(JudgeTableNames.B)
                        C: @startListClassStep.GetJudgeName(JudgeTableNames.C)
                        D: @startListClassStep.GetJudgeName(JudgeTableNames.D)
                    </div>
                }
            </td>
            <td></td>
        </tr>
        @foreach (var startListItem in startListClassStep.GetActiveStartList().OrderBy(x => x.StartNumber))
        {
            if (startListItem.IsTeam)
            {
                startnumber++;
                <tr>
                    <td>@startnumber</td>
                    <td>@startListItem.VaultingTeam?.Name</td>
                    <td>@startListItem.HorseInformation?.HorseName</td>
                    <td>@startListItem.HorseInformation?.Lunger?.LungerName</td>
                    <td>@startListItem.VaultingTeam?.VaultingClass?.ClassName klass: @startListItem.VaultingTeam?.VaultingClass?.ClassNr -
                        @(ExcelPreCompetitionData.GetCompetitionStep(Model.TypeOfContest, startListItem.VaultingTeam?.VaultingClass, startListItem.TeamTestnumber)?.Name)
                    </td>
                    <td>
                        @startListItem.VaultingTeam?.VaultingClub?.ClubName
                        (@startListItem.VaultingTeam?.VaultingClub?.Country)
                        <br />Voltigörer:<br />
                        @if (startListItem.VaultingTeam?.TeamList != null)
                        {
                            foreach (var vaulter in startListItem.VaultingTeam.TeamList.OrderBy(x => x.StartNumber))
                            {
                                @vaulter.Participant?.Name
                                <br />
                            }
                        }
                    </td>
                </tr>
            }
            else
            {
                foreach (var vaulters in startListItem.GetActiveVaulters().OrderBy(x => x.StartOrder))
                {
                    startnumber++;
                    <tr>
                        <td>@startnumber</td>
                        <td>@vaulters.Participant?.Name (@vaulters.Participant?.Armband)</td>
                        <td>@startListItem.HorseInformation?.HorseName</td>
                        <td>@startListItem.HorseInformation?.Lunger?.LungerName</td>
                        <td>@vaulters.Participant?.VaultingClass?.ClassName -
                            @(ExcelPreCompetitionData.GetCompetitionStep(Model.TypeOfContest, vaulters.Participant?.VaultingClass, vaulters.Testnumber)?.Name)
                        </td>
                        <td>@vaulters.Participant?.VaultingClub?.ClubName (@vaulters.Participant?.VaultingClub?.Country)</td>
                    </tr>
                }
            }
        }
    }
</table>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Tillbaka</a>
</div>
