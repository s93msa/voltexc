@{
    ViewData["Title"] = "Voltige";
}

<div class="container mt-3">
    <div class="card mb-3">
        <div class="card-body">
            <h4>Skapa protokoll</h4>
            <a asp-controller="Home" asp-action="CopyExcel" class="btn btn-primary">Skapa nu</a>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <h4>Skapa protokoll för utskrift</h4>
            <h6>Med startnummer först i filnamnet</h6>
            <a asp-controller="Home" asp-action="CopyExcelWithStartnumber" class="btn btn-primary">Skapa nu</a>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <h4>Visa startlista</h4>
            <a asp-controller="Home" asp-action="StartList" class="btn btn-primary">Visa nu</a>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <h4>Skapa excel för resultatprogram</h4>
            <a asp-controller="Home" asp-action="CreatePreResultInformationExcel" class="btn btn-primary">Skapa nu</a>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <h4>Skapa pdf:er för utskrift</h4>
            <a asp-controller="Home" asp-action="CreatePdfPrintFile" class="btn btn-primary">Skapa nu</a>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <h4>Importera från TDB</h4>
            <a asp-controller="Import" asp-action="Index" class="btn btn-primary">Hämta från excelfil</a>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <h4>Skapa importlista</h4>
            <a asp-controller="Home" asp-action="CreateExportStartListExcel" class="btn btn-primary">Skapa nu</a>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <h4>Skapa excel med startlista</h4>
            <a asp-controller="Home" asp-action="CreateStartListExcel" class="btn btn-primary">Skapa nu</a>
        </div>
    </div>
</div>
